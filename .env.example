# Mechanic RAG — local vertical slice (Compose Postgres + Ollama)
# Copy to web/.env.local and/or repo `.env` for ingest CLI. Do NOT commit secrets.

# --- Postgres (Compose) ---
DATABASE_URL=postgres://mechanic:mechanic@localhost:5433/mechanic_rag
DB_TIMEOUT_MS=5000

# --- Ollama (host) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
# Fallback generator if primary missing: qwen3.5:4b
OLLAMA_TIMEOUT_MS=60000

# --- Embedding candidate (freeze after fixture smoke — not yet frozen) ---
# Primary candidate: Ollama nomic-embed-text @ 768
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BASE_URL=http://127.0.0.1:11434

# --- Cross-encoder candidate (freeze after fixture benchmark — not yet frozen) ---
# Architecture candidate: cross-encoder/ms-marco-MiniLM-L-6-v2
# transformers.js uses the Xenova ONNX port of that candidate:
CE_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CE_RUNTIME=transformers_js
CE_TIMEOUT_MS=8000
CE_TOP_N=20
CE_TOP_K=8

# --- Ranking ---
RETRIEVE_TOP_N=50
RRF_K=60
# Section dedup default ON (RRF → dedup → CE). Set 0 to disable.
SECTION_DEDUP_ENABLED=1

# --- Fixtures / corpus ---
FIXTURE_ROOT=fixtures
# Never point public defaults at private Gold roots.
# Private garage / OEM Contract 7.2 Gold (local path only — never gdrive:):
# MECHANIC_PRIVATE_GOLD_ROOT=/absolute/path/to/private_gold
# Example (personal garage emit output; do not commit OEM):
# MECHANIC_PRIVATE_GOLD_ROOT=/Users/YOU/var/mechanic_garage/gold

# Garage root for bronze resolve + M1 page PNG cache (default ~/var/mechanic_garage)
# MECHANIC_GARAGE_ROOT=/Users/YOU/var/mechanic_garage

# --- Diagnostics / ablation ---
# 1 = include ask diagnostics object (no private chunk bodies)
MECHANIC_DIAGNOSTICS=0
# Guide 02 paired ask ablation: when 1, skip CE intentionally and serve
# post-RRF (+ section dedup) top-K. Diagnostics set ablation_rrf_only=true
# (NOT rerank_degraded). Requires Next process restart / second process for
# the RRF-only arm — see README "Paired ask ablation eval".
# MECHANIC_FORCE_RRF_ONLY=1

# --- M2 image retrieve (optional; degrade if index empty / CLIP unavailable) ---
# Default ON. Set 0 for paired image-channel ablation arm.
# MECHANIC_IMAGE_CHANNEL=1
# CLIP_QUERY_TIMEOUT_MS=20000
# MECHANIC_PYTHON=/absolute/path/to/mechanic_rag/.venv/bin/python
# Image embeds: optional extra  uv pip install '.[m2]'
#   .venv/bin/python -m mecharag embed-images --vehicle-prefix 'cat:%'
#   scripts/start-m2-embed-full-garage-in-terminal.sh

# --- App ---
NEXT_PUBLIC_APP_NAME=Mechanic RAG
NODE_ENV=development
