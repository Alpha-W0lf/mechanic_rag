## Environment variables (example)
# Copy this file to `.env.local` for local development.
# Do NOT commit real secrets.

# Google Gemini API
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
# For server-side operations, prefer the service role key (keep server-only!)
SUPABASE_SERVICE_ROLE_KEY=
# Only use anon key if absolutely needed on server. Do NOT expose to client.
SUPABASE_ANON_KEY=

# App configuration
NEXT_PUBLIC_APP_NAME=Mechanic RAG (S2000)
NODE_ENV=development

# Retrieval configuration
# Always-fuse (RRF) hybrid on by default; optionally set to "conditional" to fuse only on low vector confidence
RETRIEVAL_FUSION_MODE=always  # options: always | conditional
FUSION_LINEAR_ALPHA=0.7       # used if linear fusion is enabled
MMR_LAMBDA=0.4                # 0.3–0.5 typical
RETRIEVAL_K_DEFAULT=8

