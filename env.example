## Environment variables (example)
# Copy this file to `.env.local` for local development.
# Do NOT commit real secrets.

# Google Gemini API
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
# For server-side operations, prefer the service role key (keep server-only!)
SUPABASE_SERVICE_ROLE_KEY=
# Only use anon key if absolutely needed on server. Do NOT expose to client.
SUPABASE_ANON_KEY=

# App configuration
NEXT_PUBLIC_APP_NAME=Mechanic RAG (S2000)
NODE_ENV=development

